# Site config
ASTRO_SITE_URL=https://your-site-name.netlify.app

# Netlify Identity
NETLIFY_IDENTITY_JWT_SECRET=replace-with-netlify-identity-jwt-secret
ADMIN_ALLOWED_EMAILS=you@example.com,team@example.com

# GitHub access for the custom CMS save flow
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPOSITORY=your-org/your-repo-name

# Optional: used if you want additional custom auth/logging later
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# PUBLIC_GTM_ID=
# PUBLIC_SENTRY_DSN=