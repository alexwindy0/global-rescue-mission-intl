# Google Tag Manager (public — injected at build time)
PUBLIC_GTM_ID=GTM-PF6NDNBD

# Sentry Error Tracking (public DSN — injected at build time)
PUBLIC_SENTRY_DSN=

# Netlify (secrets — configure in GitHub Actions and Netlify dashboard)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_WEBHOOK_SECRET=

# Astro site URL (set per environment in netlify.toml)
ASTRO_SITE_URL=https://globalrescuemission.org
