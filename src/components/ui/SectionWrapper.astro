---
interface Props {
  id?: string;
  class?: string;
  background?: 'white' | 'gray' | 'blue';
  padding?: 'sm' | 'md' | 'lg';
}

const { id, class: className = '', background = 'white', padding = 'lg' } = Astro.props;

const backgrounds = {
  white: 'bg-white dark:bg-gray-900',
  gray: 'bg-gray-50 dark:bg-gray-800',
  blue: 'bg-blue-900 dark:bg-blue-950 text-white',
};

const paddings = {
  sm: 'py-8',
  md: 'py-16',
  lg: 'py-24',
};
---

<section
  id={id}
  class={`
    ${backgrounds[background]}
    ${paddings[padding]}
    ${className}
  `}
  data-aos="fade-up"
>
  <div class="container-grm">
    <slot />
  </div>
</section>
