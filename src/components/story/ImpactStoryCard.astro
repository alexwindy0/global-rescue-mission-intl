---
import { formatDateShort } from '@utils/date-formatter';

interface Props {
  title: string;
  date: Date;
  location: string;
  summary: string;
  impact: string;
  slug: string;
  image?: string;
  featured?: boolean;
}

const { title, date, location, summary, impact, slug, image, featured = false } = Astro.props;
---

<article
  class={`
  bg-white dark:bg-gray-800 rounded-xl overflow-hidden border transition-all
  ${featured ? 'border-amber-300 shadow-lg' : 'border-gray-100 dark:border-gray-700 hover:shadow-md'}
`}
  data-aos="fade-up"
>
  <div class="aspect-video bg-gray-200 dark:bg-gray-700 relative overflow-hidden">
    {
      image ? (
        <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <img
          src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80"
          alt={title}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      )
    }
    {
      featured && (
        <span class="absolute top-4 left-4 px-3 py-1 bg-amber-500 text-white text-xs font-bold rounded-full">
          FEATURED STORY
        </span>
      )
    }
  </div>
  <div class="p-6">
    <div class="flex items-center gap-3 mb-3">
      <span
        class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400 text-xs font-semibold rounded"
        >Story</span
      >
      <span class="text-sm text-gray-500 dark:text-gray-400">{location}</span>
      <time class="text-sm text-gray-500 dark:text-gray-400" datetime={date.toISOString()}
        >{formatDateShort(date)}</time
      >
    </div>
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
      <a
        href={`/blog/stories/${slug}`}
        class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
      >
        {title}
      </a>
    </h3>
    <p class="text-gray-600 dark:text-gray-300 text-sm mb-4 line-clamp-3">{summary}</p>
    <div class="bg-amber-50 dark:bg-amber-900/20 border-l-4 border-amber-400 p-3 rounded-r-lg">
      <p class="text-sm text-amber-800 dark:text-amber-400 font-medium">Impact: {impact}</p>
    </div>
    <a
      href={`/blog/stories/${slug}`}
      class="text-blue-600 dark:text-blue-400 text-sm font-medium mt-4 inline-block hover:underline"
    >
      Read full story &rarr;
    </a>
  </div>
</article>
