---
import { getCollection } from 'astro:content';
import { formatDate } from '@utils/date-formatter';
import CTAButton from '@components/ui/CTAButton.astro';

const prayers = await getCollection('prayers');
const latestPrayer = prayers.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

{
  latestPrayer && (
    <div
      class="bg-gradient-to-br from-purple-900 to-blue-900 text-white rounded-2xl p-8 md:p-12"
      data-aos="fade-up"
    >
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block px-3 py-1 bg-white/20 rounded-full text-sm font-medium mb-4">
          Daily Prayer — {formatDate(latestPrayer.data.date)}
        </span>
        <h2 class="text-2xl md:text-3xl font-bold mb-4">{latestPrayer.data.title}</h2>
        <p class="text-blue-100 text-lg mb-6 line-clamp-3">{latestPrayer.data.summary}</p>
        <CTAButton
          href={`/blog/prayers/${latestPrayer.slug}`}
          variant="secondary"
          class="bg-white text-blue-900 hover:bg-gray-100"
        >
          Read Full Prayer
        </CTAButton>
      </div>
    </div>
  )
}
