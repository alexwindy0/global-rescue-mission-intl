---

---

<form
  name="volunteer-signup"
  method="POST"
  data-netlify="true"
  class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 space-y-6"
>
  <input type="hidden" name="form-name" value="volunteer-signup" />

  <div>
    <h3 class="text-2xl font-bold text-gray-900 mb-2">Volunteer Signup</h3>
    <p class="text-gray-600 text-sm">
      Fill out the form below and our team will get in touch with you.
    </p>
  </div>

  <div>
    <label for="volunteer-name" class="block text-sm font-medium text-gray-700 mb-1">
      Full Name
      <input
        type="text"
        id="volunteer-name"
        name="name"
        required
        class="w-full mt-1 px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent font-normal"
        placeholder="Your full name"
      />
    </label>
  </div>

  <div>
    <label for="volunteer-email" class="block text-sm font-medium text-gray-700 mb-1">
      Email Address
      <input
        type="email"
        id="volunteer-email"
        name="email"
        required
        class="w-full mt-1 px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent font-normal"
        placeholder="you@example.com"
      />
    </label>
  </div>

  <div>
    <label for="volunteer-phone" class="block text-sm font-medium text-gray-700 mb-1">
      Phone Number (Optional)
      <input
        type="tel"
        id="volunteer-phone"
        name="phone"
        class="w-full mt-1 px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent font-normal"
        placeholder="+1 (555) 000-0000"
      />
    </label>
  </div>

  <div>
    <fieldset>
      <legend class="block text-sm font-medium text-gray-700 mb-2">Areas of Interest</legend>
      <div class="space-y-2">
        {
          [
            'Medical Missions',
            'Education & Teaching',
            'Disaster Relief',
            'Prayer & Outreach',
            'Logistics & Admin',
          ].map((interest) => (
            <label class="flex items-center space-x-3 cursor-pointer text-gray-700 text-sm font-normal">
              <input
                type="checkbox"
                name="interests"
                value={interest}
                class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500"
              />
              <span>{interest}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>

  <div>
    <label for="volunteer-message" class="block text-sm font-medium text-gray-700 mb-1">
      Tell Us About Yourself
      <textarea
        id="volunteer-message"
        name="message"
        rows="4"
        class="w-full mt-1 px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent font-normal"
        placeholder="Share your skills, experience, or availability..."></textarea>
    </label>
  </div>

  <button
    type="submit"
    class="w-full py-3 px-6 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
  >
    Submit Application
  </button>
</form>
