---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '@utils/date-formatter';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  image?: string;
  tags?: string[];
  canonical?: string;
}

const { title, description, date, author, image, tags = [], canonical } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  canonical={canonical}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Article Header -->
    <header class="py-12 md:py-16 border-b border-gray-200">
      <div class="flex flex-wrap gap-2 mb-4">
        {
          tags.map((tag) => (
            <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">
              {tag}
            </span>
          ))
        }
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">{title}</h1>
      <div class="flex items-center gap-4 text-gray-600">
        <span class="font-medium">{author}</span>
        <span aria-hidden="true">•</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </div>
    </header>

    <!-- Featured Image -->
    {
      image && (
        <div class="my-8">
          <img
            src={image}
            alt={title}
            class="w-full h-64 md:h-96 object-cover rounded-xl"
            loading="eager"
          />
        </div>
      )
    }

    <!-- Article Content -->
    <div class="prose prose-lg max-w-none py-8">
      <slot />
    </div>

    <!-- Article Footer -->
    <footer class="py-8 border-t border-gray-200 mt-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <p class="text-gray-600">
            Written by <span class="font-medium text-gray-900">{author}</span>
          </p>
          <p class="text-sm text-gray-500">Published on {formatDate(date)}</p>
        </div>
        <a href="/blog" class="text-blue-600 hover:text-blue-800 font-medium">
          ← Back to all posts
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
