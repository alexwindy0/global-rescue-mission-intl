---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTAButton from '@components/ui/CTAButton.astro';

const title = 'Page Not Found';
const description = 'The page you are looking for does not exist.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center px-4">
      <h1 class="text-6xl md:text-8xl font-bold text-blue-900 mb-4">404</h1>
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Page Not Found</h2>
      <p class="text-lg text-gray-600 mb-8 max-w-md mx-auto">
        The page you are looking for might have been removed, had its name changed, or is
        temporarily unavailable.
      </p>
      <CTAButton href="/" variant="primary" size="lg">Go Back Home</CTAButton>
    </div>
  </div>
</BaseLayout>
