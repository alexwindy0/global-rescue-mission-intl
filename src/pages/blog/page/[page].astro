---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '@utils/date-formatter';

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 10;
  const prayers = await getCollection('prayers');
  const stories = await getCollection('stories');
  const allPosts = [...prayers, ...stories].sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
    props: {
      posts: allPosts.slice(i * POSTS_PER_PAGE, (i + 1) * POSTS_PER_PAGE),
      currentPage: i + 1,
      totalPages,
    },
  }));
}

const { posts, currentPage, totalPages } = Astro.props;
const title = `Blog & Updates — Page ${currentPage}`;
const description = 'Daily prayers, impact stories, and mission updates.';
---

<BaseLayout title={title} description={description}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-white">Blog & Updates</h1>
      <p class="text-blue-100 mt-2">Page {currentPage} of {totalPages}</p>
    </div>
  </SectionWrapper>

  <SectionWrapper>
    <div class="space-y-6">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.collection}/${post.slug}`}
            class="flex flex-col md:flex-row gap-6 p-6 bg-white rounded-xl border border-gray-100 hover:border-blue-200 transition-colors group"
            data-aos="fade-up"
            data-aos-delay={i * 50}
          >
            <div class="md:w-48 h-32 bg-gray-200 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-2xl" aria-hidden="true">
                📄
              </span>
            </div>
            <div class="flex-grow">
              <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs font-semibold rounded">
                  {post.collection}
                </span>
                <time class="text-sm text-gray-500" datetime={post.data.date.toISOString()}>
                  {formatDateShort(post.data.date)}
                </time>
              </div>
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-600 mt-1 line-clamp-2">{post.data.summary}</p>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Pagination -->
    <nav class="mt-12 flex justify-center items-center gap-2" aria-label="Blog pagination">
      {
        currentPage > 1 && (
          <a
            href={currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`}
            class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors"
          >
            ← Previous
          </a>
        )
      }
      <span class="px-4 py-2 text-gray-600">
        Page {currentPage} of {totalPages}
      </span>
      {
        currentPage < totalPages && (
          <a
            href={`/blog/page/${currentPage + 1}`}
            class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors"
          >
            Next →
          </a>
        )
      }
    </nav>
  </SectionWrapper>
</BaseLayout>
