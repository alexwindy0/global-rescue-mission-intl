---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '@utils/date-formatter';

const title = 'Blog & Updates';
const description =
  'Daily prayers, impact stories, and mission updates from Global Rescue Mission International.';

const prayers = await getCollection('prayers');
const stories = await getCollection('stories');
const allPosts = [...prayers, ...stories].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredPosts = allPosts.filter((p) => p.data.featured).slice(0, 3);
const recentPosts = allPosts.slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white">{title}</h1>
      <p class="text-blue-100 mt-4 text-lg">Prayers, stories, and mission updates</p>
    </div>
  </SectionWrapper>

  <!-- Featured Posts -->
  {
    featuredPosts.length > 0 && (
      <SectionWrapper background="gray">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Featured</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featuredPosts.map((post, i) => (
            <a
              href={`/blog/${post.collection}/${post.slug}`}
              class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group"
              data-aos="fade-up"
              data-aos-delay={i * 100}
            >
              <div class="aspect-video bg-gray-200 flex items-center justify-center">
                <span class="text-4xl" aria-hidden="true">
                  📖
                </span>
              </div>
              <div class="p-6">
                <span class="text-xs font-semibold text-blue-600 uppercase tracking-wide">
                  {post.collection}
                </span>
                <h3 class="text-xl font-bold text-gray-900 mt-2 group-hover:text-blue-700 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-gray-600 mt-2 text-sm line-clamp-2">{post.data.summary}</p>
                <time
                  class="text-sm text-gray-400 mt-4 block"
                  datetime={post.data.date.toISOString()}
                >
                  {formatDateShort(post.data.date)}
                </time>
              </div>
            </a>
          ))}
        </div>
      </SectionWrapper>
    )
  }

  <!-- Recent Posts -->
  <SectionWrapper>
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Recent Posts</h2>
    <div class="space-y-6">
      {
        recentPosts.map((post, i) => (
          <a
            href={`/blog/${post.collection}/${post.slug}`}
            class="flex flex-col md:flex-row gap-6 p-6 bg-white rounded-xl border border-gray-100 hover:border-blue-200 transition-colors group"
            data-aos="fade-up"
            data-aos-delay={i * 50}
          >
            <div class="md:w-48 h-32 bg-gray-200 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-2xl" aria-hidden="true">
                📄
              </span>
            </div>
            <div class="flex-grow">
              <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs font-semibold rounded">
                  {post.collection}
                </span>
                <time class="text-sm text-gray-500" datetime={post.data.date.toISOString()}>
                  {formatDateShort(post.data.date)}
                </time>
              </div>
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors">
                {post.data.title}
              </h3>
              <p class="text-gray-600 mt-1 line-clamp-2">{post.data.summary}</p>
              <span class="text-blue-600 text-sm font-medium mt-2 inline-block">Read more →</span>
            </div>
          </a>
        ))
      }
    </div>
  </SectionWrapper>
</BaseLayout>
