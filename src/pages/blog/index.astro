---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '@utils/date-formatter';

const title = 'Blog & Updates';
const description =
  'Daily prayers, impact stories, and mission updates from Global Rescue Mission International.';

const prayers = await getCollection('prayers');
const stories = await getCollection('stories');
const allPosts = [...prayers, ...stories].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredPosts = allPosts.filter((p) => p.data.featured).slice(0, 3);
const recentPosts = allPosts.slice(0, 10);

const fallbackImage =
  'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80';
---

<BaseLayout title={title} description={description}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white">{title}</h1>
      <p class="text-blue-100 mt-4 text-lg">Prayers, stories, and mission updates</p>
    </div>
  </SectionWrapper>

  {
    featuredPosts.length > 0 && (
      <SectionWrapper background="gray">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Featured</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featuredPosts.map((post, i) => (
            <a
              href={`/blog/${post.collection}/${post.slug}`}
              class="bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group"
              data-aos="fade-up"
              data-aos-delay={i * 100}
            >
              <div class="aspect-video bg-gray-200 dark:bg-gray-700 overflow-hidden">
                <img
                  src={post.data.image || fallbackImage}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wide">
                  {post.collection}
                </span>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mt-2 group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-300 mt-2 text-sm line-clamp-2">
                  {post.data.summary}
                </p>
                <time
                  class="text-sm text-gray-400 dark:text-gray-500 mt-4 block"
                  datetime={post.data.date.toISOString()}
                >
                  {formatDateShort(post.data.date)}
                </time>
              </div>
            </a>
          ))}
        </div>
      </SectionWrapper>
    )
  }

  <SectionWrapper>
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Recent Posts</h2>
    <div class="space-y-6">
      {
        recentPosts.map((post, i) => (
          <a
            href={`/blog/${post.collection}/${post.slug}`}
            class="flex flex-col md:flex-row gap-6 p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-blue-200 dark:hover:border-blue-600 transition-all group"
            data-aos="fade-up"
            data-aos-delay={i * 50}
          >
            <div class="md:w-48 h-32 bg-gray-200 dark:bg-gray-700 rounded-lg overflow-hidden flex-shrink-0">
              <img
                src={post.data.image || fallbackImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="flex-grow">
              <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400 text-xs font-semibold rounded">
                  {post.collection}
                </span>
                <time
                  class="text-sm text-gray-500 dark:text-gray-400"
                  datetime={post.data.date.toISOString()}
                >
                  {formatDateShort(post.data.date)}
                </time>
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 mt-1 line-clamp-2">{post.data.summary}</p>
              <span class="text-blue-600 dark:text-blue-400 text-sm font-medium mt-2 inline-block">
                Read more &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </SectionWrapper>
</BaseLayout>
