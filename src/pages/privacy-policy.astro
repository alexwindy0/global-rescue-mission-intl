---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'privacy-policy');
if (!page) {
  throw new Error('Privacy policy page content not found');
}
const { Content } = await page.render();

const title = page.data.title;
const description = page.data.description;
---

<BaseLayout title={title} description={description} noindex={true}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-white">{title}</h1>
    </div>
  </SectionWrapper>

  <SectionWrapper>
    <article class="prose prose-lg max-w-4xl mx-auto" data-aos="fade-up">
      <Content />
    </article>
  </SectionWrapper>
</BaseLayout>
