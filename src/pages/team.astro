---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';
import teamData from '../data/team-members.json';

const title = 'Our Team';
const description =
  'Meet the dedicated leaders and volunteers behind Global Rescue Mission International.';
---

<BaseLayout title={title} description={description}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white">{title}</h1>
      <p class="text-blue-100 mt-4 text-lg">Dedicated servants making a global impact</p>
    </div>
  </SectionWrapper>

  <SectionWrapper>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        teamData.members.map((member, i) => (
          <div
            class="bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all"
            data-aos="fade-up"
            data-aos-delay={i * 100}
          >
            <div class="aspect-square bg-gray-200 dark:bg-gray-700 overflow-hidden">
              {member.image ? (
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div
                  class="w-full h-full flex items-center justify-center text-6xl text-gray-400"
                  aria-hidden="true"
                >
                  <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">{member.name}</h3>
              <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">{member.role}</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm">{member.bio}</p>
            </div>
          </div>
        ))
      }
    </div>
  </SectionWrapper>
</BaseLayout>
