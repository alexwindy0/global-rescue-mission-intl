---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';

const title = 'Our Programs';
const description = 'Discover our ongoing programs and initiatives around the world.';

const programs = [
  {
    title: 'Midnight Prayer Network',
    desc: 'A global community praying together every day at midnight for our mission fields. Join thousands of believers worldwide in united prayer.',
    status: 'Active',
    image:
      'https://images.unsplash.com/photo-1504052434569-70ad5836ab65?auto=format&fit=crop&w=600&q=80',
  },
  {
    title: 'Child Sponsorship Program',
    desc: "Sponsor a child's education, nutrition, and healthcare for just $40/month. Receive updates and letters from your sponsored child.",
    status: 'Active',
    image:
      'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80',
  },
  {
    title: 'Volunteer Deployment',
    desc: 'Short-term and long-term volunteer opportunities in medical, educational, and construction missions. Training provided.',
    status: 'Recruiting',
    image:
      'https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=600&q=80',
  },
  {
    title: 'Disaster Response Team',
    desc: 'Rapid response units trained and ready to deploy within 72 hours of a natural disaster or conflict outbreak.',
    status: 'Active',
    image:
      'https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=600&q=80',
  },
];
---

<BaseLayout title={title} description={description}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white">{title}</h1>
      <p class="text-blue-100 mt-4 text-lg">Sustainable initiatives for lasting change</p>
    </div>
  </SectionWrapper>

  <SectionWrapper>
    <div class="space-y-16 max-w-4xl mx-auto">
      {
        programs.map((program, i) => (
          <div
            class="flex flex-col md:flex-row gap-8 items-start"
            data-aos="fade-up"
            data-aos-delay={i * 100}
          >
            <div class="md:w-1/3">
              <div class="aspect-video bg-gray-200 dark:bg-gray-700 rounded-lg overflow-hidden">
                <img
                  src={program.image}
                  alt={program.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="md:w-2/3">
              <div class="flex items-center gap-3 mb-2">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{program.title}</h2>
                <span
                  class={`
                px-3 py-1 rounded-full text-xs font-semibold
                ${program.status === 'Active' ? 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400' : 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400'}
              `}
                >
                  {program.status}
                </span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-lg">{program.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </SectionWrapper>
</BaseLayout>
