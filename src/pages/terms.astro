---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';

const title = 'Terms of Service';
const description = 'Terms of service for using the Global Rescue Mission International website.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-white">{title}</h1>
    </div>
  </SectionWrapper>

  <SectionWrapper>
    <article class="prose prose-lg max-w-4xl mx-auto">
      <p><strong>Last Updated:</strong> August 13, 2026</p>
      <h2>1. Acceptance of Terms</h2>
      <p>
        By accessing and using this website, you accept and agree to be bound by these Terms of
        Service...
      </p>
      <h2>2. Use of Website</h2>
      <p>
        This website is provided for informational purposes and to facilitate donations and
        volunteer signups...
      </p>
      <h2>3. Donations</h2>
      <p>All donations are final and non-refundable except as required by law...</p>
      <h2>4. Intellectual Property</h2>
      <p>All content on this website is the property of Global Rescue Mission International...</p>
      <h2>5. Contact</h2>
      <p>For questions about these terms, contact legal@globalrescuemission.org</p>
    </article>
  </SectionWrapper>
</BaseLayout>
