---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionWrapper from '@components/ui/SectionWrapper.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
if (!page) {
  throw new Error('About page content not found');
}
const { Content } = await page.render();

const title = page.data.title;
const description = page.data.description;
---

<BaseLayout title={title} description={description}>
  <SectionWrapper background="blue" padding="sm">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white">{title}</h1>
    </div>
  </SectionWrapper>

  <SectionWrapper>
    <article class="prose prose-lg max-w-4xl mx-auto" data-aos="fade-up">
      <Content />
    </article>
  </SectionWrapper>

  <SectionWrapper background="gray">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6" data-aos="fade-up">Our Values</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {
          [
            { title: 'Faith', desc: 'Grounded in the Gospel, driven by compassion.' },
            { title: 'Integrity', desc: 'Transparent stewardship of every donation.' },
            { title: 'Impact', desc: 'Measurable, sustainable change in every community.' },
          ].map((value, i) => (
            <div
              class="bg-white p-6 rounded-xl shadow-sm"
              data-aos="fade-up"
              data-aos-delay={i * 100}
            >
              <h3 class="text-xl font-bold text-blue-900 mb-2">{value.title}</h3>
              <p class="text-gray-600">{value.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </SectionWrapper>
</BaseLayout>
